# =============================================
# DeepShield Environment Configuration
# =============================================
# Copy this file to .env and fill in your values

# --- Application ---
APP_NAME=DeepShield
APP_VERSION=1.0.0
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- Security ---
# No JWT — simple token auth (user_id embedded in opaque token)

# --- Database ---
# JSON file store: data is saved in deepshield_db.json (no server needed)
DB_PATH=deepshield_db.json

# --- AI Models ---
# Set DEMO_MODE=true for fast offline demo (uses calibrated random predictions)
# Set DEMO_MODE=false to use real HuggingFace models (requires internet on first run)
DEMO_MODE=true

# Image model (only used when DEMO_MODE=false)
IMAGE_MODEL_NAME=timm/efficientnet_b4.ra2_in1k

# Video model (only used when DEMO_MODE=false)
# Options: frame_efficientnet | videomae
VIDEO_MODEL=frame_efficientnet
VIDEO_MAE_MODEL=MCG-NJU/videomae-base

# Audio model (only used when DEMO_MODE=false)
AUDIO_MODEL_NAME=facebook/wav2vec2-base-960h

# --- File Upload ---
UPLOAD_MAX_SIZE_MB=100
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/bmp
ALLOWED_VIDEO_TYPES=video/mp4,video/avi,video/mov,video/mkv
ALLOWED_AUDIO_TYPES=audio/wav,audio/mp3,audio/ogg,audio/flac,audio/mpeg

# --- Reports ---
REPORTS_DIR=reports
FRONTEND_URL=http://localhost:5500
